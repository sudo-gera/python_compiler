@subheader '''
import create_ast
'''

# spaces

new_line: token=r'(#[^\n]*)?(\n|$)' { token }

spaces:
    | 'if_in_brackets\0' a=spaces_in_brackets { a }
    | spaces_not_in_brackets

spaces_in_brackets: tokens=(!r'$' new_line).spaces_not_in_brackets+ { tokens[0] }

spaces_not_in_brackets: token=r'([^\S\n]|\\\n)*' { token }

spaces_for_indent: token=r'[^\S\n]*' { token }

# tokens

m_token: token=r'\*|@|//|/|%' spaces { token }

a_token: token=r'\+|-' spaces { token }

shift_token: token=r'<<|>>' spaces { token }

bit_and_token: token=r'&' spaces { token }

bit_xor_token: token=r'\^' spaces { token }

bit_or_token: token=r'\|' spaces { token }

comp_token: token=r'>=|<=|<|>|==|!=' spaces { token }

aug_token: token=r'\+=|-=|\*=|@=|//=|/=|%=|\*\*=|>>=|<<=|&=|\^=|\|=' spaces { token }

u_token: token=r'-|\+|~' spaces { token }

colon_token: token=r':' spaces { token }

walrus_token: token=r':=' spaces { token }

semicolon_token: token=r';' spaces { token }

dot_token: token=r'\.' spaces { token }

comma_token: token=r',' spaces { token }

star_token: token=r'\*' spaces { token }

starstar_token: token=r'\*\*' spaces { token }

assign_token: token=r'=' !r'=' spaces { token }

returns_token: token=r'->' spaces { token }

decorator_token: token=r'@' spaces { token }

slash_token: token=r'/' spaces { token }

left_paren_token: token=r'\(' start_bracket spaces { token }
right_paren_token: token=r'\)' stop_bracket spaces { token }

left_bracket_token: token=r'\[' start_bracket spaces { token }
right_bracket_token: token=r'\]' stop_bracket spaces { token }

left_brace_token: token=r'\{' start_bracket spaces { token }
right_brace_token: token=r'\}' stop_bracket spaces { token }

# name tokens

if_token: token=r'if\b' spaces { token }

elif_token: token=r'elif\b' spaces { token }

else_token: token=r'else\b' spaces { token }

for_token: token=r'for\b' spaces { token }

in_token: token=r'in\b' spaces { token }

is_token: token=r'is\b' spaces { token }

not_token: token=r'not\b' spaces { token }

while_token: token=r'while\b' spaces { token }

async_token: token=r'async\b' spaces { token }

await_token: token=r'await\b' spaces { token if create_ast.to_char_parser(self)._func_level[-1] == 2 else create_ast.to_char_parser(self)._error() }

return_token: token=r'return\b' spaces { token if create_ast.to_char_parser(self)._func_level[-1] else create_ast.to_char_parser(self)._error() }

yield_token: token=r'yield\b' spaces { token if create_ast.to_char_parser(self)._func_level[-1] else create_ast.to_char_parser(self)._error() }

from_token: token=r'from\b' spaces { token }

lambda_token: token=r'lambda\b' spaces { token }

pass_token: token=r'pass\b' spaces { token }

del_token: token=r'del\b' spaces { token }

raise_token: token=r'raise\b' spaces { token }

assert_token: token=r'assert\b' spaces { token }

break_token: token=r'break\b' spaces { token if create_ast.to_char_parser(self)._loop_level[-1] else create_ast.to_char_parser(self)._error() }

continue_token: token=r'continue\b' spaces { token if create_ast.to_char_parser(self)._loop_level[-1] else create_ast.to_char_parser(self)._error() }

import_token: token=r'import\b' spaces { token }

as_token: token=r'as\b' spaces { token }

global_token: token=r'global\b' spaces { token }

nonlocal_token: token=r'nonlocal\b' spaces { token }

type_token: token=r'type\b' spaces { token }

and_token: token=r'and\b' spaces { token }

or_token: token=r'or\b' spaces { token }

def_token: token=r'def\b' spaces { token }

try_token: token=r'try\b' spaces { token }

except_token: token=r'except\b' spaces { token }

finally_token: token=r'finally\b' spaces { token }

with_token: token=r'with\b' spaces { token }

match_token: token=r'match\b' spaces { token }

case_token: token=r'case\b' spaces { token }

class_token: token=r'class\b' spaces { token }

none_token: token=r'None\b' spaces { token }

true_token: token=r'True\b' spaces { token }

false_token: token=r'False\b' spaces { token }

# str literals

start_stre_q: r'' {[create_ast.to_char_parser(self)._stre_level.append('\042')]}
start_stre_a: r'' {[create_ast.to_char_parser(self)._stre_level.append('\047')]}
start_stre_qqq: r'' {[create_ast.to_char_parser(self)._stre_level.append('\042\042\042')]}
start_stre_aaa: r'' {[create_ast.to_char_parser(self)._stre_level.append('\047\047\047')]}
start_stre_b: r'' {[create_ast.to_char_parser(self)._stre_level.append('\175')]}

stre1: token=r'.' { [token,create_ast.to_char_parser(self)._stre_level.pop()][0] if +token==create_ast.to_char_parser(self)._stre_level[-1] else None }
stre3: token=r'...' { [token,create_ast.to_char_parser(self)._stre_level.pop()][0] if +token==create_ast.to_char_parser(self)._stre_level[-1] else None }

stre:
    | stre1
    | stre3

str_char:
    | 'str\0f'  token='\\{\\{'                { a('\173') }
    | 'str\0f'  token='\\}\\}'                { a('\175') }
    | 'str\0f'  token='\\{\\}'                { None }
    | 'str\0f'  a=r'\{' value_begin=spaces value=f_expression as_token=assign_token? conversion='(![ras])?' format_spec=(r':' 'append_str\0f' start_stre_b str_end 'pop_str\0f' | r'\}') {
        [
            ast.Constant(
                token = a,
                value=create_ast.to_char_parser(self)._tokenizer.text[value_begin.pos:conversion.pos] if as_token else '',
            ),
            ast.FormattedValue(
                token = a,
                value=value,
                conversion=ord(conversion()[-1]) if +conversion else 114 if isinstance(format_spec, create_ast.to_char_parser(self)._token) and as_token else -1,
                format_spec=(
                    None
                        if isinstance(format_spec, create_ast.to_char_parser(self)._token) else
                    ast.JoinedStr(
                        token=a,
                        values=[
                            values
                                if not values or isinstance(values[-1],ast.Constant) else
                            values+[ast.Constant(token=format_spec[0], value='')]
                        for values in [+format_spec[3]]][0]
                    )
                )
            )
        ][not as_token:]
    }
    | 'str\0'   token='\\\\\n'                { token('') if 'r' not in create_ast.to_char_parser(self)._str_level[-1] else token }
    | 'str\0'   token='\\\\\\\\'              { token('\\') if 'r' not in create_ast.to_char_parser(self)._str_level[-1] else token }
    | 'str\0'   token='\\\\\47'               { token("\47") if 'r' not in create_ast.to_char_parser(self)._str_level[-1] else token("\\\47") }
    | 'str\0'   token='\\\\\42'               { token('\42') if 'r' not in create_ast.to_char_parser(self)._str_level[-1] else token("\\\42") }
    | 'str\0R'  token='\\\\a'                 { token('\7')  }
    | 'str\0R'  token='\\\\b'                 { token('\10') }
    | 'str\0R'  token='\\\\t'                 { token('\11') }
    | 'str\0R'  token='\\\\n'                 { token('\12') }
    | 'str\0R'  token='\\\\v'                 { token('\13') }
    | 'str\0R'  token='\\\\f'                 { token('\14') }
    | 'str\0R'  token='\\\\r'                 { token('\15') }
    | 'str\0R'  token='\\\\[0-7][0-7]?[0-7]?' { token(chr([c if 'b' not in create_ast.to_char_parser(self)._str_level[-1] else c % 256 for c in [int(token()[1:], 8)]][0])) }
    | 'str\0R'  token='\\\\x[0-9a-fA-F]{2}'   { token(chr(int(token()[2:], 16))) }
    | 'str\0RB' token='\\\\N\\{[^}]*\\}'      { [None if c is None else token(c) for c in [create_ast.to_char_parser(self)._unicode_lookup(token()[3:-1])]][0] }
    | 'str\0RB' token='\\\\u[0-9a-fA-F]{4}'   { token(chr(int(token()[2:], 16))) if 'r' not in create_ast.to_char_parser(self)._str_level[-1] else token }
    | 'str\0RB' token='\\\\U[0-9a-fA-F]{8}'   { [token(chr(c)) if c < 0x110000 else None for c in [int(token()[2:], 16)]][0] if 'r' not in create_ast.to_char_parser(self)._str_level[-1] else token }
    | 'str\0'   token=r'\n'                   { token if len(create_ast.to_char_parser(self)._stre_level[-1])==3 else create_ast.to_char_parser(self)._error() }
    | 'str\0B'   token=r'[^{}\42\47\\\n]+'    { token }
    | 'str\0b'   token=r'[^{}\42\47\\\n]+'    { token if all([len(t.encode())<2 for t in +token]) else None }
    | 'str\0b'   token=r'.'                   { token if all([len(t.encode())<2 for t in +token]) else None }
    | 'str\0B'   token=r'.'                   { token }

str_end:
    | a=stre { create_ast.to_char_parser(self)._make_true([]) }
    | a=str_char b=str_end {
        [
            b().extend(a[::-1])
                if not isinstance(a, create_ast.to_char_parser(self)._token) else
            b().append(ast.Constant(token=a, value=+a)),
            b
        ][1]
    }

str_content:
    | token='\x27\x27\x27' start_stre_aaa data=str_end { data }
    | token='\x22\x22\x22' start_stre_qqq data=str_end { data }
    | token='\x27' start_stre_a data=str_end { data }
    | token='\x22' start_stre_q data=str_end { data }

formatted_str_data: data=str_content { create_ast.to_char_parser(self)._make_true(data()[::-1]) }

simple_str_data: data=formatted_str_data { create_ast.to_char_parser(self)._make_true(''.join([n.value for n in +data])) }

byte_str_data: data=simple_str_data { create_ast.to_char_parser(self)._make_true(bytes([*map(ord, +data)])) }



str_with_prefix:
    | token=r'[Rr][Bb]|[Bb][Rr]' 'append_str\0br' data=byte_str_data?      'pop_str\0br' { ast.Constant(token=token,  value=+data) if data else None }
    | token=r'[Ff][Rr]|[Rr][Ff]' 'append_str\0fr' data=formatted_str_data? 'pop_str\0fr' { ast.JoinedStr(token=token, values=+data) if data else None }
    | token=r'[Bb]'              'append_str\0b'  data=byte_str_data?      'pop_str\0b'  { ast.Constant(token=token,  value=+data) if data else None }
    | token=r'[fF]'              'append_str\0f'  data=formatted_str_data? 'pop_str\0f'  { ast.JoinedStr(token=token, values=+data) if data else None }
    | token=r'[rR]'              'append_str\0r'  data=simple_str_data?    'pop_str\0r'  { ast.Constant(token=token,  value=+data) if data else None }
    | token=r'[Uu]?'             'append_str\0'   data=simple_str_data?    'pop_str\0'   { ast.Constant(token=token,  value=+data, kind=+token if +token else None) if data else None }

stringliteral: tokens=(str_with_prefix spaces)+ {
    create_ast.to_char_parser(self)._join_str([token[0] for token in tokens])
}

# int literals

integer:
    | r'[1-9][_0-9]*'
    | r'0[bB][_01]+'
    | r'0[oO][_0-7]+'
    | r'0[xX][_0-9a-fA-F]+'
    | r'0[_0]*'

digitpart: r'[0-9][_0-9]*'

pointfloat:
    | a=[digitpart] b=r'\.' c=digitpart { a+b+c }
    | a=digitpart b=r'\.' { a+b }

exponentfloat : a=(pointfloat | digitpart) b=r'[eE][+-]?' c=digitpart { a+b+c }

floatnumber: 
    | exponentfloat
    | pointfloat

imagnumber: a=(floatnumber | digitpart) b=r'[jJ]' { a+b }

# literals and constants

literal:
    | stringliteral
    | token=imagnumber spaces { ast.Constant(token=token, value=complex(+token)) }
    | token=floatnumber spaces { ast.Constant(token=token, value=float(+token)) }
    | token=integer spaces { ast.Constant(token=token, value=int(+token, 0)) }

constant:
    | token=none_token spaces { ast.Constant(token=token, value=None) }
    | token=r'\.\.\.' spaces { ast.Constant(token=token, value=...) }
    | token=false_token spaces { ast.Constant(token=token, value=False) }
    | token=true_token spaces { ast.Constant(token=token, value=True) }

# names

identifier: token=r'[^\W0-9]\w*' spaces { token }

get_name: token=identifier { ast.Name(token=token, id=+token, ctx=ast.Load(token=token)) }

set_name: token=identifier { ast.Name(token=token, id=+token, ctx=ast.Store(token=token)) }

del_name: token=identifier { ast.Name(token=token, id=+token, ctx=ast.Del(token=token)) }

get_attributeref_suffix: dot_token attr=identifier { lambda value: ast.Attribute(token=value.token, value=value, attr=+attr, ctx=ast.Load(token=value.token)) }

set_attributeref: value=primary { ast.Attribute(token=value.token, value=value.value, attr=value.attr, ctx=ast.Store(token=value.token)) if isinstance(value, ast.Attribute) else None }

del_attributeref: value=primary { ast.Attribute(token=value.token, value=value.value, attr=value.attr, ctx=ast.Del(token=value.token)) if isinstance(value, ast.Attribute) else None }

sub_item: #local
    | lower=[expression] token=colon_token upper=[expression] step=[ colon_token [expression] ] { ast.Slice(token=token, lower=lower, upper=upper, step=step[1] if step else None) }
    | expression

get_subscription_suffix: left_bracket_token slices=comma_token.sub_item+ tc=comma_token? right_bracket_token { lambda value: ast.Subscript(token=value.token, value=value, slice=ast.Tuple(token=value.token, elts=slices, ctx=ast.Load(token=value.token)) if len(slices) != 1 or tc else slices[0], ctx=ast.Load(token=value.token)) }

set_subscription: value=primary { ast.Subscript(token=value.token, value=value.value, slice=value.slice, ctx=ast.Store(token=value.token)) if isinstance(value, ast.Subscript) else None }

del_subscription: value=primary { ast.Subscript(token=value.token, value=value.value, slice=value.slice, ctx=ast.Del(token=value.token)) if isinstance(value, ast.Subscript) else None }

# displays

arithmetic_parentheses:
    | left_paren_token value=yield_expression right_paren_token { value }
    | left_paren_token value=walrus_expression right_paren_token { value }

comp_for: a=([async_token] for_token set_multiple_targets in_token ready_to_if_expr (if_token ready_to_if_expr)*)+ {
    create_ast.to_char_parser(self)._make_true([
        ast.comprehension(
            token=a[1],
            target=a[2],
            iter=a[4],
            ifs=[a[1] for a in a[5]] if a[5] else [],
            is_async=+bool(a[0]),
        ) if not a[0] or create_ast.to_char_parser(self)._func_level[-1] == 2 else create_ast.to_char_parser(self)._error()
    for a in a])
} #local

display_item: #local
    | walrus_expression
    | star_token value=ready_to_be_starred_expr { ast.Starred(token=value.token, value=value, ctx=ast.Load(token=value.token)) }

display_content: #local
    | walrus_expression comp_for
    | comma_token.display_item+ comma_token?

tuple_display: token=left_paren_token content=display_content? right_paren_token {
    None
        if content and not content[1] and len(content[0]) == 1 else
    ast.GeneratorExp(token=token, elt=content[0], generators=+content[1])
        if content and content[1] and +content[1] != ',' else
    ast.Tuple(token=token, elts=content[0] if content else [], ctx=ast.Load(token=token))
}

list_display: token=left_bracket_token content=display_content? right_bracket_token {
    ast.ListComp(token=token, elt=content[0], generators=+content[1])
        if content and content[1] and +content[1] != ',' else
    ast.List(token=token, elts=content[0] if content else [], ctx=ast.Load(token=token))
}

set_display: token=left_brace_token content=display_content right_brace_token {
    ast.SetComp(token=token, elt=content[0], generators=+content[1])
        if content[1] and +content[1] != ',' else
    ast.Set(token=token, elts=content[0] if content else [])
}

dict_display_item: #local
    | key=expression colon_token value=expression { [key, value] }
    | starstar_token value=ready_to_be_starred_expr { [None, value] }

dict_display_content: #local
    | expression colon_token expression comp_for
    | comma_token.dict_display_item+ comma_token?

dict_display: token=left_brace_token content=dict_display_content? right_brace_token {
    ast.Dict(token=token, keys=[], values=[])
        if not content else
    ast.Dict(token=token, **dict(zip('keys values'.split(), map(list, zip(*content[0])))))
        if len(content) == 2 else
    ast.DictComp(token=token, key=content[0], value=content[2], generators=+content[3])
}

call_arg: #local
    | arg=identifier assign_token value=expression { ast.keyword(token=arg, arg=+arg, value=value) }
    | starstar_token value=expression { ast.keyword(token=value.token, value=value) }
    | star_token value=expression { ast.Starred(token=value.token, value=value, ctx=ast.Load(token=value.token)) }
    | walrus_expression

call_args: '' args=[comma_token.call_arg+ comma_token?] {
    dict(args=[], keywords=[])
        if not args else
    dict(args=[arg for arg in args[0] if type(arg)!=ast.keyword], keywords=[arg for arg in args[0] if type(arg)==ast.keyword])
        if not any([
            isinstance(arg1, ast.keyword) and not isinstance(arg2, ast.keyword | ast.Starred)
                or
            isinstance(arg1, ast.keyword) and arg1.arg==None and not isinstance(arg2, ast.keyword)
        for n,arg2 in enumerate(args[0]) for arg1 in args[0][:n]]) else
    None
}

call_suffix: token=left_paren_token args=(walrus_expression comp_for | call_args) right_paren_token {
    lambda func: (
        ast.Call(token=token, func=func, args=[ast.GeneratorExp(token=func.token, elt=args[0], generators=+args[1])], keywords=[])
            if isinstance(args, list) else
        ast.Call(token=token, func=func, args=args['args'], keywords=args['keywords'])
    )
}

# primary

suffix:
    | call_suffix
    | get_subscription_suffix
    | get_attributeref_suffix

atom:
    | tuple_display
    | list_display
    | dict_display
    | set_display
    | literal
    | constant
    | get_name
    | arithmetic_parentheses

primary: value=atom suffixes=suffix* {
    create_ast.to_char_parser(self)._functools.reduce(
        lambda value, suffix: suffix(value),
        suffixes,
        value,
    )
}

# operators

await_expr: new_node=await_token? value=primary { ast.Await(token=value.token, value=value) if new_node else value }

power: left=(await_expr) new_node=[starstar_token u_expr] { ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+new_node[0]](token=new_node[0]), right=new_node[1]) if new_node else left } #local

u_expr: #local
    | power
    | op=u_token operand=u_expr { ast.UnaryOp(token=operand.token, operand=operand, op=create_ast.to_char_parser(self)._un_op_to_ast[+op](token=op)) }

m_expr: left=u_expr right=(m_token u_expr)* { create_ast.to_char_parser(self)._functools.reduce(lambda left, right: ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+right[0]](token=right[0]), right=right[1]),right,left) } #local

a_expr: left=m_expr right=(a_token m_expr)* { create_ast.to_char_parser(self)._functools.reduce(lambda left, right: ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+right[0]](token=right[0]), right=right[1]),right,left) } #local

shift_expr: left=a_expr right=(shift_token a_expr)* { create_ast.to_char_parser(self)._functools.reduce(lambda left, right: ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+right[0]](token=right[0]), right=right[1]),right,left) } #local

and_expr: left=shift_expr right=(bit_and_token shift_expr)* { create_ast.to_char_parser(self)._functools.reduce(lambda left, right: ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+right[0]](token=right[0]), right=right[1]),right,left) } #local

xor_expr: left=and_expr right=(bit_xor_token and_expr)* { create_ast.to_char_parser(self)._functools.reduce(lambda left, right: ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+right[0]](token=right[0]), right=right[1]),right,left) } #local

or_expr: left=xor_expr right=(bit_or_token xor_expr)* { create_ast.to_char_parser(self)._functools.reduce(lambda left, right: ast.BinOp(token=left.token, left=left, op=create_ast.to_char_parser(self)._bin_op_to_ast[+right[0]](token=right[0]), right=right[1]),right,left) } #local

ready_to_be_starred_expr: or_expr

comp_operator: #local
    | op=comp_token { create_ast.to_char_parser(self)._bin_op_to_ast[+op](token=op) }
    | a=is_token s=not_token? { ast.IsNot(token=a) if s else ast.Is(token=a) }
    | s=not_token? a=in_token { ast.NotIn(token=a) if s else ast.In(token=a) }

comparison: left=ready_to_be_starred_expr new_node=(comp_operator ready_to_be_starred_expr)* {
    ast.Compare(
        token=left.token,
        left=left,
        ops=[op for op,comparator in new_node],
        comparators=[comparator for op,comparator in new_node],
    ) if new_node else left
} #local

not_test : #local
    | op=not_token operand=not_test { ast.UnaryOp(token=operand.token, op=ast.Not(token=operand.token), operand=operand) }
    | comparison

and_test: left=not_test right=(and_token not_test)* { ast.BoolOp(token=left.token, op=ast.And(token=left.token), values=[left] + [value[1] for value in right]) if right else left } #local

or_test: left=and_test right=(or_token and_test)* { ast.BoolOp(token=left.token, op=ast.Or(token=left.token), values=[left] + [value[1] for value in right]) if right else left } #local

ready_to_if_expr: or_test

conditional_expression: left=ready_to_if_expr new_node=[if_token ready_to_if_expr else_token expression] { ast.IfExp(token=left.token, body=left, test=new_node[1], orelse=new_node[3]) if new_node else left }

expression:
    | token=lambda_token args=parameter_list_lmbd colon_token body=expression {
        ast.Lambda(
            token=token,
            args=args,
            body=body,
        )
    }
    | conditional_expression

tupled_expression: vs=comma_token.expression+ tc=comma_token? { vs[0] if len(vs) == 1 and not tc else ast.Tuple(token=vs[0].token, elts=vs, ctx=ast.Load(token=vs[0].token)) }

walrus_expression: new_node=[set_name walrus_token] value=expression { ast.NamedExpr(token=value.token, target=new_node[0], value=value) if new_node else value }

yield_expression:
    | token=yield_token from_token value=expression { ast.YieldFrom(token=token, value=value) }
    | token=yield_token value=tupled_expression? { ast.Yield(token=token, value=value) }
    | tupled_expression

f_expression:
    | yield_expression
    | conditional_expression

# indentation

start_bracket: r'' {[create_ast.to_char_parser(self)._bracket_level.append(None)]}

stop_bracket: r'' {[create_ast.to_char_parser(self)._bracket_level.pop()]}

start_loop: r'' {[create_ast.to_char_parser(self)._loop_level.append(1)]}

stop_loop: r'' {[create_ast.to_char_parser(self)._loop_level.pop()]}

start_func: r'' {[create_ast.to_char_parser(self)._loop_level.append(0), create_ast.to_char_parser(self)._func_level.append(1)]}

stop_func: r'' {[create_ast.to_char_parser(self)._loop_level.pop(), create_ast.to_char_parser(self)._func_level.pop()]}

start_coro: r'' {[create_ast.to_char_parser(self)._loop_level.append(0), create_ast.to_char_parser(self)._func_level.append(2)]}

stop_coro: r'' {[create_ast.to_char_parser(self)._loop_level.pop(), create_ast.to_char_parser(self)._func_level.pop()]}

indent: a=spaces_for_indent {
    [create_ast.to_char_parser(self)._indent_levels.__setitem__(-1, +a), a][1]
        if
            create_ast.to_char_parser(self)._indent_levels[-1] == None
                and
            a() != create_ast.to_char_parser(self)._indent_levels[-2]
                and
            a().startswith(create_ast.to_char_parser(self)._indent_levels[-2])
        else
    [None, a][create_ast.to_char_parser(self)._indent_levels[-1] == +a]
}

# lines

semicolon_separated_statements: a=(semicolon_token).simple_stmt+ semicolon_token? new_line { create_ast.to_char_parser(self)._make_true(a) } #local

line_content: #local
    | a=multiple_lines_statement {create_ast.to_char_parser(self)._make_true([a])}
    | indent a=semicolon_separated_statements { a }

line: #local
    | r'$' { None }
    | spaces new_line { create_ast.to_char_parser(self)._make_true([]) }
    | a=line_content { a }

code_block: 'append_indent\0' a=line+ 'pop_indent\0' {
    create_ast.to_char_parser(self)._make_true([d for s in a for d in +s])
} #local

body: #local
    | semicolon_separated_statements
    | new_line a=code_block { a if +a else None }

colon_and_body: colon_token a=body { a }

colon_and_loop_body: start_loop a=colon_and_body stop_loop { a }

colon_and_func_body: start_func a=colon_and_body stop_func { a }

colon_and_coro_body: start_coro a=colon_and_body stop_coro { a }

start: token=r'^' a=line* r'$' {
    ast.Module(
        token=token,
        body=[d for s in a for d in +s],
        type_ignores=[]
    )
}

# multiline statements

multiple_lines_statement: #TODO match
    | coro_def
    | func_def
    | async_for_stmt
    | for_stmt
    | while_stmt
    | if_stmt
    | try_stmt
    | with_stmt
    | async_with_stmt
    | class_def

if_stmt: indent=indent token=if_token test=walrus_expression body=colon_and_body mebbe=(indent elif_token walrus_expression colon_and_body)* orelse=[indent else_token colon_and_body] {
        create_ast.to_char_parser(self)._functools.reduce(
            lambda a,s: [ast.If(token=s[1], test=s[2], body=+s[3], orelse=a)],
            ([[indent, token, test, body]] + (mebbe if mebbe else []))[::-1],
            +orelse[2] if orelse else []
        )[0]
    }

for_stmt: indent token=for_token target=set_multiple_targets in_token iter=expression body=colon_and_loop_body orelse=[indent else_token colon_and_body] {
        ast.For(
            token=token,
            target=target,
            iter=iter,
            body=+body,
            orelse=+orelse[2] if orelse else [],
        )
    }

async_for_stmt: indent async_token token=for_token target=set_multiple_targets in_token iter=expression body=colon_and_loop_body orelse=[indent else_token colon_and_body] {
        ast.AsyncFor(
            token=token,
            target=target,
            iter=iter,
            body=+body,
            orelse=+orelse[2] if orelse else [],
        ) if create_ast.to_char_parser(self)._func_level[-1] == 2 else create_ast.to_char_parser(self)._error()
    }

while_stmt: indent token=while_token test=walrus_expression body=colon_and_loop_body orelse=[indent else_token colon_and_body] {
        ast.While(
            token=token,
            test=test,
            body=+body,
            orelse=+orelse[2] if orelse else [],
        )
    }

try_stmt: '' a=(try_group | try_except | try_finally) {
    (
        ast.TryStar if a[3] and len(a[3][0]) == 5 else ast.Try
    )(
        token=a[1],
        body=+a[2],
        handlers=[ast.ExceptHandler(token=a[1], type=handler[-2][0] if handler[-2] else None, name=+handler[-2][1][1] if handler[-2] and handler[-2][1] else None, body=+handler[-1]) for handler in a[3]],
        orelse=+a[4][2] if a[4] else [],
        finalbody=+a[5][2] if a[5] else [],
    )
}

# try

try_except: indent token=try_token body=colon_and_body handlers=except_colon+ orelse=[indent else_token colon_and_body] finalbody=[indent finally_token colon_and_body]
try_group: indent token=try_token body=colon_and_body handlers=except_star+ orelse=[indent else_token colon_and_body] finalbody=[indent finally_token colon_and_body]
try_finally: indent token=try_token body=colon_and_body handlers=(!'')* orelse=(!'')* finalbody=(indent finally_token colon_and_body)

except_colon: indent q=except_token w=[expression [as_token identifier]] e=colon_and_body
except_star: a=(indent except_token star_token [expression [as_token identifier]] colon_and_body) { a if a[2] else create_ast.to_char_parser(self)._error() }


with_stmt_impl: #local
    | token=with_token left_paren_token items=comma_token.(expression [as_token set_array_target])+ comma_token? right_paren_token body=colon_and_body
    | token=with_token items=comma_token.(expression [as_token set_array_target])+ body=colon_and_body

with_stmt: indent a=with_stmt_impl {
    ast.With(
        token=a[0],
        items=[ast.withitem(token=a[0], context_expr=item[0], optional_vars=item[1][1] if item[1] else None) for item in a[1]],
        body=+a[2],
    )
}

async_with_stmt: indent async_token a=with_stmt_impl {
    ast.AsyncWith(
        token=a[0],
        items=[ast.withitem(token=a[0], context_expr=item[0], optional_vars=item[1][1][0] if item[1] else None) for item in a[1]],
        body=+a[2],
    ) if create_ast.to_char_parser(self)._func_level[-1] == 2 else create_ast.to_char_parser(self)._error()
}

class_def: decorator_list=decorator_list indent token=class_token name=identifier type_params=[type_params] args=[left_paren_token call_args right_paren_token] body=colon_and_body {
    ast.ClassDef(
        token=token,
        name=+name,
        bases=args[1]['args'] if args else [],
        keywords=args[1]['keywords'] if args else [],
        body=+body,
        decorator_list=+decorator_list,
        type_params = +type_params if type_params else []
    )
}

# functions

parameter_with_colon: arg=identifier colon_token annotation=expression { ast.arg(token=arg, arg=+arg, annotation=annotation) if create_ast.to_char_parser(self)._args_level[-1] else None }
parameter_without_colon: arg=identifier { ast.arg(token=arg, arg=+arg, annotation=None) }
parameter:
    | parameter_with_colon
    | parameter_without_colon
defparameter: arg=parameter default=[assign_token expression] { [arg, default[1] if default else None] }
parameter_starstar: starstar_token kwarg=parameter [comma_token] { dict(kwarg=kwarg) }
parameter_list_starargs   : 
    | others=parameter_starstar { dict(vararg=None, kwonlyargs=[], kw_defaults=[]) | others }
    | star_token vararg=[parameter] kwonlyargs=(comma_token defparameter)* others=[comma_token [parameter_starstar]] {
        (
            others[1] if others and others[1] else dict(posonlyargs=[],args=[],kwonlyargs=[],kw_defaults=[],defaults=[])
        ) | dict(
            vararg=vararg,
            kwonlyargs=[q[1][0] for q in kwonlyargs] if kwonlyargs else [],
            kw_defaults=[q[1][1] for q in kwonlyargs] if kwonlyargs else [],
        )
    }
parameter_list_no_posonly : 
    | args=comma_token.defparameter+ others=[comma_token [parameter_list_starargs]] {
        (
            others[1] if others and others[1] else dict(posonlyargs=[],args=[],kwonlyargs=[],kw_defaults=[],defaults=[])
        ) | dict(
            args=[arg[0] for arg in args],
            defaults=[arg[1] for arg in args],
        )
    }
    | others=parameter_list_starargs  { dict(args=[], defaults=[]) | others }
parameter_list:  
    | posonlyargs=comma_token.defparameter+ comma_token slash_token others=[comma_token [parameter_list_no_posonly]] {
        (
            others[1] if others and others[1] else dict(posonlyargs=[],args=[],kwonlyargs=[],kw_defaults=[],defaults=[])
        ) | dict(
            posonlyargs=[arg[0] for arg in posonlyargs],
            defaults=[arg[1] for arg in posonlyargs] + (others[1]['defaults'] if others and others[1] else []),
        )
    }
    | others=parameter_list_no_posonly { dict(posonlyargs=[]) | others }
parameter_list_preprocessed: args=parameter_list {
    args | dict(defaults=[arg for arg in args['defaults'] if arg])
        if not any([w is None and e is not None for q,w in enumerate(args['defaults']) for e in args['defaults'][:q]]) else
    create_ast.to_char_parser(self)._error()
}
start_func_args: token=r'' {[token, create_ast.to_char_parser(self)._args_level.append(1)]}
stop_func_args: token=r'' {[token, create_ast.to_char_parser(self)._args_level.pop()]}
start_lmbd_args: token=r'' {[token, create_ast.to_char_parser(self)._args_level.append(0)]}
stop_lmbd_args: token=r'' {[token, create_ast.to_char_parser(self)._args_level.pop()]}
parameter_list_func: token=start_func_args args=parameter_list_preprocessed? stop_func_args {
    ast.arguments(token=token[0], **args) if args else ast.arguments(token=token[0], posonlyargs=[], args=[], kwonlyargs=[], kw_defaults=[], defaults=[])
}
parameter_list_lmbd: token=start_lmbd_args args=parameter_list_preprocessed? stop_lmbd_args {
    ast.arguments(token=token[0], **args) if args else ast.arguments(token=token[0], posonlyargs=[], args=[], kwonlyargs=[], kw_defaults=[], defaults=[])
}
decorator: indent decorator_token a=walrus_expression new_line { a }
decorator_or_spaces:
    | decorator
    | spaces new_line { ... }
decorator_list: a=decorator_or_spaces* { create_ast.to_char_parser(self)._make_true([q for q in a if q is not ...]) }

func_signature: def_token=def_token name=identifier type_params=[type_params] left_paren_token args=parameter_list_func? right_paren_token returns=[returns_token expression] {
    lambda decorator_list, a_token, body: (ast.AsyncFunctionDef if a_token else ast.FunctionDef)(
        token=a_token if a_token else def_token,
        decorator_list=+decorator_list,
        name=+name,
        type_params=+type_params if type_params else [],
        args=args,
        returns=returns[1] if returns else None,
        body=+body,
    )
}

func_def: decorator_list=decorator_list indent data=func_signature body=colon_and_func_body {
    data(decorator_list, None, body)
}

coro_def: decorator_list=decorator_list indent a_token=async_token data=func_signature body=colon_and_coro_body {
    data(decorator_list, a_token, body)
}

# targets

set_single_target:
    | left_paren_token target=set_single_target right_paren_token { [target[0], 0] }
    | target=set_attributeref { [target, 0] }
    | target=set_subscription { [target, 0] }
    | target=set_name { [target, 1] }

del_single_target: #local
    | left_paren_token target=del_single_target right_paren_token { [target[0], 0] }
    | target=del_attributeref { [target, 0] }
    | target=del_subscription { [target, 0] }
    | target=del_name { [target, 1] }

set_array_target:
    | target=set_single_target { target[0] }
    | token=left_paren_token targets=[set_multiple_targets] right_paren_token { targets if targets else ast.Tuple(token=token, elts=[], ctx=ast.Store(token=token)) }
    | token=left_bracket_token targets=[set_array_targets] right_bracket_token { ast.List(token=token, elts=targets[0] if targets else [], ctx=ast.Store(token=token)) }
    | token=star_token value=set_array_target { None if isinstance(value, ast.Starred) else ast.Starred(token=token, value=value, ctx=ast.Store(token=token)) }

del_array_target: #local
    | target=del_single_target { target[0] }
    | token=left_paren_token targets=[del_multiple_targets] right_paren_token { targets if targets else ast.Tuple(token=token, elts=[], ctx=ast.Del(token=token)) }
    | token=left_bracket_token targets=[del_array_targets] right_bracket_token { ast.List(token=token, elts=targets[0] if targets else [], ctx=ast.Del(token=token)) }
    | token=star_token value=del_array_target { None if isinstance(value, ast.Starred) else ast.Starred(token=token, value=value, ctx=ast.Del(token=token)) }

set_array_targets: comma_token.set_array_target+ comma_token? #local

del_array_targets: comma_token.del_array_target+ comma_token?

set_multiple_targets: targets=set_array_targets { ast.Tuple(token=targets[0][0].token, elts=targets[0], ctx=ast.Store(token=targets[0][0].token)) if len(targets[0]) != 1 or targets[1] else targets[0][0] }

del_multiple_targets: targets=del_array_targets { ast.Tuple(token=targets[0][0].token, elts=targets[0], ctx=ast.Del(token=targets[0][0].token)) if len(targets[0]) != 1 or targets[1] else targets[0][0] } #local

# simple statements

simple_stmt:
    | assert_stmt
    | pass_stmt
    | del_stmt
    | return_stmt
    | raise_stmt
    | break_stmt
    | continue_stmt
    | import_stmt
    | global_stmt
    | nonlocal_stmt
    | type_stmt
    | augmented_assignment_stmt
    | annotated_assignment_stmt
    | assignment_stmt
    | expression_stmt

expression_stmt: a=yield_expression { ast.Expr(token=a.token, value=a) }

assignment_stmt: targets=(set_multiple_targets assign_token)+ value=yield_expression { ast.Assign(token=value.token, targets=[target[0] for target in targets], value=value) }

augmented_assignment_stmt: target=set_single_target op=aug_token value=yield_expression { ast.AugAssign(token=op, target=target[0], op=create_ast.to_char_parser(self)._bin_op_to_ast[op()[:-1]](token=op), value=value) }

annotated_assignment_stmt: target=set_single_target token=colon_token annotation=expression value=[assign_token yield_expression]  { ast.AnnAssign(token=token, target=target[0], annotation=annotation, value=value[1] if value else None, simple=target[1]) }

assert_stmt: token=assert_token test=expression msg=[comma_token expression] { ast.Assert(token=token, test=test, msg=msg[1] if msg else None) }

pass_stmt:  token=pass_token { ast.Pass(token=token) }

del_stmt:  token=del_token targets=del_array_targets { ast.Delete(token=token, targets=targets[0]) }

return_stmt:  token=return_token value=tupled_expression? { ast.Return(token=token, value=value) }

raise_stmt:  token=raise_token exc=[expression [from_token expression]] { ast.Raise(token=token, exc=exc[0] if exc else None, cause=exc[1][1] if exc and exc[1] else None) }

break_stmt:  token=break_token { ast.Break(token=token) }

continue_stmt:  token=continue_token { ast.Continue(token=token) }

module: #local
    | dot_token+ &import_token [!import_token]
    | dot_token* dot_token.identifier+

import_stmt:
    | token=import_token names=comma_token.(dot_token.identifier+ [as_token identifier])+ {
        ast.Import(
            token=token,
            names=[
                ast.alias(
                    token=name[0][0],
                    name='.'.join([+c for c in name[0]]),
                    asname=+name[1][1] if name[1] else None
                )
            for name in names]
        )
    }
    | token=from_token module=module import_token names=comma_token.(identifier [as_token identifier])+ {
        ast.ImportFrom(
            token=token,
            module='.'.join([+c for c in module[1]]) if module[1] else None,
            names=[ast.alias(token=token, name=+name[0], asname=+name[1][1] if name[1] else None) for name in names],
            level=len(module[0])
        )
    }
    | token=from_token module=module import_token left_paren_token names=comma_token.(identifier [as_token identifier])+ comma_token? right_paren_token {
        ast.ImportFrom(
            token=token,
            module='.'.join([+c for c in module[1]]) if module[1] else None,
            names=[ast.alias(token=token, name=+name[0], asname=+name[1][1] if name[1] else None) for name in names],
            level=len(module[0])
        )
    }
    | token=from_token module=module import_token star_token {
        ast.ImportFrom(
            token=token,
            module='.'.join([+c for c in module[1]]) if module[1] else None,
            names=[ast.alias(token, name='*')],
            level=len(module[0])
        ) if create_ast.to_char_parser(self)._func_level[-1] == 0 else create_ast.to_char_parser(self)._error()
    }

global_stmt: token=global_token names=comma_token.identifier+ { ast.Global(token=token, names=[+name for name in names]) }

nonlocal_stmt: token=nonlocal_token names=comma_token.identifier+ { ast.Nonlocal(token=token, names=[+name for name in names]) }

type_stmt: token=type_token name=set_name type_params=[type_params] assign_token value=expression {
    ast.TypeAlias(
        token=token,
        name=name,
        type_params=+type_params if type_params else [],
        value=value,
    )
}

type_params: left_bracket_token params=comma_token.type_param+ right_bracket_token { create_ast.to_char_parser(self)._make_true(params) } #local

type_param: #local
    | name=identifier colon_token bound=expression { ast.TypeVar(token=name, name=+name, bound=bound) }
    | name=identifier { ast.TypeVar(token=name, name=+name) }
    | star_token name=identifier { ast.TypeVarTuple(token=name, name=+name) }
    | starstar_token name=identifier { ast.ParamSpec(token=name, name=+name) }
